<idea-plugin>
    <id>plugin.local-llm-assistant</id>
    <name>Local LLM Assistant</name>
    <version>1.0.0</version>
    <vendor>Local</vendor>

    <description>Chat with a local LLM via LM Studio's OpenAI-compatible API.</description>

    <!-- IntelliJ IDEA 2025.2.x build range -->
    <idea-version since-build="252"/>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool window shown in the right stripe -->
        <toolWindow
            id="Local LLM"
            anchor="right"
            secondary="false"
            icon="/icons/localLlm.svg"
            factoryClass="plugin.toolwindow.ChatToolWindowFactory"/>

        <!-- Application-level persistent settings -->
        <applicationService
            serviceImplementation="plugin.settings.PluginSettings"/>

        <notificationGroup id="Local LLM Notification Group" displayType="BALLOON"/>

    </extensions>

    <actions>
        <group id="LocalLLM.ActionGroup" text="Local LLM" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </group>

        <action id="LocalLLM.OpenChat"
                class="plugin.action.OpenChatAction"
                text="Open Local LLM Chat"
                description="Open the Local LLM chat panel">
            <add-to-group group-id="LocalLLM.ActionGroup" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt L"/>
        </action>

        <action id="LocalLLM.ExplainCode"
                class="plugin.action.ExplainCodeAction"
                text="Explain Selected Code"
                description="Send selected code to Local LLM for explanation">
            <add-to-group group-id="LocalLLM.ActionGroup" anchor="after" relative-to-action="LocalLLM.OpenChat"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt E"/>
        </action>

        <action id="LocalLLM.GenerateTest"
                class="plugin.action.GenerateTestAction"
                text="Generate Tests for This File"
                description="Ask Local LLM to generate JUnit 5 tests for the current file">
            <add-to-group group-id="LocalLLM.ActionGroup" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt T"/>
        </action>
    </actions>

</idea-plugin>
