<idea-plugin>
    <id>plugin.my-local-llm-plugin</id>
    <name>Local LLM Assistant</name>
    <version>1.0.0</version>
    <vendor email="R.NazmusSalahin@ibfd.org">Rocky</vendor>

    <description><![CDATA[
        Chat with local LLMs (Ollama, LM Studio) directly inside IntelliJ IDEA.
        Supports streaming responses, file context injection, image attachments,
        clipboard image paste, and auto file editing with diff preview.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
            serviceImplementation="plugin.settings.PluginSettings"/>

        <applicationConfigurable
            parentId="tools"
            instance="plugin.settings.SettingsUI"
            id="plugin.settings.SettingsUI"
            displayName="Local LLM Assistant"/>

        <toolWindow
            id="Local LLM Assistant"
            anchor="right"
            factoryClass="plugin.MyPluginFactory"/>
    </extensions>

    <actions>
        <action id="plugin.SendSelectionAction"
                class="plugin.actions.SendSelectionAction"
                text="Send Selection to Local LLM"
                description="Send the current selection to the Local LLM Assistant chat">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift L"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
