<idea-plugin>
    <id>plugin.local-llm-assistant</id>
    <name>Local LLM Assistant</name>
    <version>1.0.0</version>
    <vendor>Local</vendor>

    <description>Chat with a local LLM via LM Studio's OpenAI-compatible API.</description>

    <!-- IntelliJ IDEA 2025.2.x build range -->
    <idea-version since-build="252"/>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool window shown in the right stripe -->
        <toolWindow
            id="Local LLM"
            anchor="right"
            secondary="false"
            factoryClass="plugin.toolwindow.ChatToolWindowFactory"/>

        <!-- Application-level persistent settings -->
        <applicationService
            serviceImplementation="plugin.settings.PluginSettings"/>

    </extensions>

</idea-plugin>
