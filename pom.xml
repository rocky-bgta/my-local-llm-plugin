<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>plugin</groupId>
    <artifactId>my-local-llm-plugin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Local LLM Assistant</name>
    <description>IntelliJ IDEA plugin for local LLM integration (Ollama / LM Studio)</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <intellij.home>C:/Program Files/JetBrains/IntelliJ IDEA 2025.2.5</intellij.home>
    </properties>

    <dependencies>
        <!-- IntelliJ Platform SDK (system scope - provided by IDE at runtime) -->
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>app</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/app.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>util</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/util.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>util-8</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/util-8.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>annotations</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/annotations.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>lib</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/lib.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-core</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.core.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-core-impl</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.core.impl.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-core-ui</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.core.ui.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-lang</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.lang.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-lang-core</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.lang.core.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-lang-impl</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.lang.impl.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-editor</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.editor.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-ide</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.ide.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-ide-core</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.ide.core.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-ide-impl</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.ide.impl.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-projectModel</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.projectModel.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-projectModel-impl</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.projectModel.impl.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-analysis</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.analysis.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>util-rt</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/util_rt.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.jetbrains.intellij</groupId>
            <artifactId>platform-diff</artifactId>
            <version>2025.2.5</version>
            <scope>system</scope>
            <systemPath>${intellij.home}/lib/intellij.platform.diff.jar</systemPath>
        </dependency>

        <!-- Gson for JSON parsing -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <!-- Apache HttpClient5 for HTTP + SSE streaming -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <version>5.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents.core5</groupId>
            <artifactId>httpcore5</artifactId>
            <version>5.2.4</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <compilerArgs>
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifestEntries>
                            <Built-By>LocalLLMPlugin</Built-By>
                        </manifestEntries>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
