<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>plugin</groupId>
    <artifactId>local-llm-assistant</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Local LLM Assistant</name>

    <properties>
        <!-- ── Java ─────────────────────────────────────────────────────── -->
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ── IntelliJ Platform ─────────────────────────────────────────
             To upgrade: change intellij.version + intellij.version.full only.
             All paths, dependency versions, and plugin dir are derived.      -->
        <intellij.version>2025.2</intellij.version>
        <intellij.version.full>2025.2.5</intellij.version.full>
        <intellij.install.dir>C:/Program Files/JetBrains/IntelliJ IDEA ${intellij.version.full}</intellij.install.dir>
        <intellij.lib>${intellij.install.dir}/lib</intellij.lib>
        <!-- The IDE you actually run/restart to load the plugin. Decoupled from the
             compile-time SDK above because the running IDE may differ. Community
             Edition uses the "IdeaIC" config-dir prefix; Ultimate uses "IntelliJIdea". -->
        <intellij.run.version>2025.2</intellij.run.version>
        <intellij.config.dir>IdeaIC${intellij.run.version}</intellij.config.dir>
        <intellij.plugins.dir>${env.APPDATA}/JetBrains/${intellij.config.dir}/plugins</intellij.plugins.dir>
        <intellij.plugin.install.dir>${intellij.plugins.dir}/${project.artifactId}/lib</intellij.plugin.install.dir>

        <!-- ── Test dependency versions ─────────────────────────────────── -->
        <junit.version>5.10.2</junit.version>
        <mockito.version>5.2.0</mockito.version>

        <!-- ── Maven plugin versions ─────────────────────────────────────── -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
        <maven.antrun.plugin.version>3.1.0</maven.antrun.plugin.version>
    </properties>

    <dependencies>

        <!-- ================================================================
             IntelliJ Platform SDK — system scope (provided by IDE at runtime)
             ================================================================ -->
        <dependency>
            <groupId>com.intellij</groupId>
            <artifactId>app</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/app.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij</groupId>
            <artifactId>util</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/util.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij</groupId>
            <artifactId>util-8</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/util-8.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij</groupId>
            <artifactId>util_rt</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/util_rt.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij</groupId>
            <artifactId>annotations</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/annotations.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij</groupId>
            <artifactId>lib</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/lib.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij.platform</groupId>
            <artifactId>core</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/intellij.platform.core.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij.platform</groupId>
            <artifactId>core-impl</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/intellij.platform.core.impl.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij.platform</groupId>
            <artifactId>core-ui</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/intellij.platform.core.ui.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij.platform</groupId>
            <artifactId>ide</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/intellij.platform.ide.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij.platform</groupId>
            <artifactId>ide-core</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/intellij.platform.ide.core.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij.platform</groupId>
            <artifactId>ide-impl</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/intellij.platform.ide.impl.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij.platform</groupId>
            <artifactId>projectModel</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/intellij.platform.projectModel.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij.platform</groupId>
            <artifactId>analysis</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/intellij.platform.analysis.jar</systemPath>
        </dependency>

        <!-- Icons (AllIcons) -->
        <dependency>
            <groupId>com.intellij.platform</groupId>
            <artifactId>util-ui</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/intellij.platform.util.ui.jar</systemPath>
        </dependency>

        <!-- Bundled Gson — system scope (provided by IntelliJ at runtime) -->
        <dependency>
            <groupId>com.intellij.bundled</groupId>
            <artifactId>gson</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/intellij.libraries.gson.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>com.intellij.bundled</groupId>
            <artifactId>fastutil</artifactId>
            <version>${intellij.version}</version>
            <scope>system</scope>
            <systemPath>${intellij.lib}/intellij.libraries.fastutil.jar</systemPath>
        </dependency>

        <!-- ── Test dependencies ─────────────────────────────────────────── -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.7</version>
        </dependency>

    </dependencies>

    <build>
        <!-- Derived from artifactId — stays in sync automatically -->
        <finalName>${project.artifactId}</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
                <configuration>
                    <archive>
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven.antrun.plugin.version}</version>
                <executions>
                    <execution>
                        <id>install-plugin-to-intellij</id>
                        <phase>install</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${intellij.plugin.install.dir}"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="${intellij.plugin.install.dir}"
                                      overwrite="true"/>
                                <echo level="info" message=""/>
                                <echo level="info" message="========================================"/>
                                <echo level="info" message="  Plugin installed successfully!"/>
                                <echo level="info" message="  ${project.build.finalName}.jar  v${project.version}"/>
                                <echo level="info" message="  -> ${intellij.plugin.install.dir}"/>
                                <echo level="info" message="  Restart IntelliJ IDEA to load the update."/>
                                <echo level="info" message="========================================"/>
                                <echo level="info" message=""/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
    </build>

</project>
